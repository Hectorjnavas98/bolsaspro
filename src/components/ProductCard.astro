---
interface Props {
  name: string;
  image: string;
  rating: number;
  price: string;
  amazonUrl: string;
  badge?: string;
  features: string[];
}

const { name, image, rating, price, amazonUrl, badge, features } = Astro.props;

const stars = Array.from({ length: 5 }, (_, i) => i < Math.round(rating));

const asinMatch = amazonUrl.match(/\/dp\/([A-Z0-9]{10})/);
const asin = asinMatch ? asinMatch[1] : '';
---

<article class="bg-bg-card rounded-xl border border-border p-6 hover:shadow-lg hover:border-primary/30 transition-all relative group" data-asin={asin}>
  {badge && (
    <span class="absolute -top-3 left-4 bg-accent text-white text-xs font-bold px-3 py-1 rounded-full z-10 shadow-sm animate-pulse-slow">
      {badge}
    </span>
  )}
  <div class="flex flex-col items-center">
    <a href={amazonUrl} target="_blank" rel="nofollow noopener sponsored" class="w-44 h-44 mb-4 relative block cursor-pointer">
      <img src={image} alt={name} class="w-44 h-44 object-contain product-img transition-transform group-hover:scale-110" loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
      <div class="w-44 h-44 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg items-center justify-center text-center p-3 border border-blue-200 product-img-fallback" style="display:none;">
        <span class="text-xs text-blue-600 font-medium leading-tight">{name}</span>
      </div>
    </a>
    <a href={amazonUrl} target="_blank" rel="nofollow noopener sponsored" class="hover:text-primary transition-colors">
      <h3 class="font-semibold text-center text-lg mb-2 product-title">{name}</h3>
    </a>
    <div class="flex items-center gap-0.5 mb-2 product-rating">
      {stars.map((filled) => (
        <svg class={`w-4 h-4 ${filled ? 'text-yellow-400' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      ))}
      <span class="text-sm text-text-light ml-1 rating-value">{rating}</span>
    </div>
    <div class="mb-2 text-center">
      <p class="text-2xl font-bold text-primary product-price">{price}</p>
      <p class="text-xs text-text-light product-price-note">Precio orientativo · <a href={amazonUrl} target="_blank" rel="nofollow noopener sponsored" class="text-primary hover:underline font-medium">ver precio actual</a></p>
    </div>
    <div class="mb-3 product-availability">
      <a href={amazonUrl} target="_blank" rel="nofollow noopener sponsored" class="inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full bg-green-50 text-green-700 hover:bg-green-100 transition-colors availability-badge">
        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        <span class="availability-text">Disponible - Ver oferta</span>
      </a>
    </div>
    <ul class="text-sm text-text-light space-y-1 mb-4 w-full">
      {features.map((f) => (
        <li class="flex items-start gap-2">
          <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
          </svg>
          {f}
        </li>
      ))}
    </ul>
    <a
      href={amazonUrl}
      target="_blank"
      rel="nofollow noopener sponsored"
      class="w-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold py-3.5 px-6 rounded-lg text-center transition-all product-cta flex items-center justify-center gap-2 shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
      Ver precio en Amazon
    </a>
    <div class="flex items-center justify-center gap-3 mt-2 text-xs text-text-light">
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
        Compra segura
      </span>
      <span class="flex items-center gap-1">
        <svg class="w-3 h-3 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
        Envio gratis Prime
      </span>
    </div>
  </div>
</article>
