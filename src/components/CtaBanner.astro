---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonUrl: string;
}

const { title, description, buttonText, buttonUrl } = Astro.props;
---

<div class="bg-gradient-to-r from-primary to-blue-700 text-white rounded-xl p-8 mt-12 text-center shadow-lg">
  <h2 class="text-2xl font-bold mb-3">{title}</h2>
  <p class="text-blue-100 mb-6 max-w-2xl mx-auto">{description}</p>
  <a href={buttonUrl} target="_blank" rel="nofollow noopener sponsored" class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold py-4 px-10 rounded-lg transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5 text-lg">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
    {buttonText}
  </a>
  <p class="text-blue-200 text-xs mt-4 flex items-center justify-center gap-2">
    <span class="flex items-center gap-1"><svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>Compra segura en Amazon</span>
    <span>·</span>
    <span>Envio gratis con Prime</span>
    <span>·</span>
    <span>Devoluciones 30 dias</span>
  </p>
</div>
