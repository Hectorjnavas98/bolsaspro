---
interface Product {
  name: string;
  type: string;
  area: string;
  price: string;
  rating: number;
  amazonUrl: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;

function extractAsin(url: string): string {
  const match = url.match(/\/dp\/([A-Z0-9]{10})/);
  return match ? match[1] : '';
}
---

<div class="overflow-x-auto">
  <table class="w-full border-collapse bg-bg-card rounded-xl overflow-hidden border border-border">
    <thead>
      <tr class="bg-primary text-white">
        <th class="p-3 text-left text-sm font-semibold">Producto</th>
        <th class="p-3 text-left text-sm font-semibold">Tipo</th>
        <th class="p-3 text-left text-sm font-semibold hidden md:table-cell">Compatibilidad</th>
        <th class="p-3 text-center text-sm font-semibold">Precio</th>
        <th class="p-3 text-center text-sm font-semibold">Nota</th>
        <th class="p-3 text-center text-sm font-semibold"></th>
      </tr>
    </thead>
    <tbody>
      {products.map((product, i) => {
        const asin = extractAsin(product.amazonUrl);
        return (
          <tr class={`border-t border-border ${i === 0 ? 'bg-amber-50 ring-2 ring-amber-200 ring-inset' : i % 2 === 0 ? 'bg-white' : 'bg-bg'} hover:bg-blue-50 transition-colors`} data-asin={asin}>
            <td class="p-3 font-medium text-sm">
              <a href={product.amazonUrl} target="_blank" rel="nofollow noopener sponsored" class="hover:text-primary transition-colors">
                {i === 0 && <span class="inline-block bg-amber-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded mr-1 align-middle">TOP 1</span>}
                {product.name}
              </a>
            </td>
            <td class="p-3 text-sm text-text-light">{product.type}</td>
            <td class="p-3 text-sm text-text-light hidden md:table-cell">{product.area}</td>
            <td class="p-3 text-center font-bold text-primary text-sm product-price">{product.price}</td>
            <td class="p-3 text-center text-sm">
              <div class="flex items-center justify-center gap-0.5">
                {Array.from({ length: 5 }, (_, idx) => (
                  <svg class={`w-3 h-3 ${idx < Math.round(product.rating) ? 'text-yellow-400' : 'text-gray-300'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
                <span class="ml-1 text-xs text-text-light rating-value">{product.rating}</span>
              </div>
            </td>
            <td class="p-3 text-center">
              <a
                href={product.amazonUrl}
                target="_blank"
                rel="nofollow noopener sponsored"
                class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white text-xs font-bold py-2.5 px-4 rounded-lg transition-all whitespace-nowrap shadow-sm hover:shadow-md transform hover:-translate-y-0.5"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
                Ver oferta
              </a>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <p class="text-xs text-text-light mt-2 text-right flex items-center justify-end gap-1">
    <svg class="w-3 h-3 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
    Precios verificados mayo 2026 · Haz clic en "Ver oferta" para ver el precio actual
  </p>
</div>
