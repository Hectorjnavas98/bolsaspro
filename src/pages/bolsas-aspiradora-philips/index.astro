          </thead>
          <tbody>
            <tr class="border-b"><td class="px-4 py-2">Filtracion de particulas finas</td><td class="px-4 py-2 text-center text-green-600 font-bold">99,5%</td><td class="px-4 py-2 text-center text-orange-600">85-90%</td></tr>
            <tr class="border-b bg-gray-50"><td class="px-4 py-2">Retencion de alergenos</td><td class="px-4 py-2 text-center text-green-600 font-bold">Excelente</td><td class="px-4 py-2 text-center text-orange-600">Media</td></tr>
            <tr class="border-b"><td class="px-4 py-2">Resistencia a roturas</td><td class="px-4 py-2 text-center text-green-600 font-bold">Muy alta</td><td class="px-4 py-2 text-center text-orange-600">Baja</td></tr>
            <tr class="border-b bg-gray-50"><td class="px-4 py-2">Mantenimiento de succion</td><td class="px-4 py-2 text-center text-green-600 font-bold">Estable</td><td class="px-4 py-2 text-center text-orange-600">Disminuye rapido</td></tr>
            <tr class="border-b"><td class="px-4 py-2">Duracion por bolsa</td><td class="px-4 py-2 text-center text-green-600 font-bold">4-8 semanas</td><td class="px-4 py-2 text-center text-orange-600">2-4 semanas</td></tr>
