---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const tag = "espacioseco-21";
const amazonUrl = (asin: string) => `https://www.amazon.es/dp/${asin}?tag=${tag}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Como encuentro la bolsa compatible con mi aspiradora?",
      "acceptedAnswer": { "@type": "Answer", "text": "Usa nuestro buscador: selecciona la marca de tu aspiradora o escribe el modelo en el campo de busqueda. Te mostraremos las bolsas compatibles con tu aspiradora, con enlace directo a Amazon para comprarlas al mejor precio." }
    },
    {
      "@type": "Question",
      "name": "Puedo usar bolsas de otra marca en mi aspiradora?",
      "acceptedAnswer": { "@type": "Answer", "text": "Si, muchas bolsas son compatibles entre marcas. Por ejemplo, las bolsas Bosch tipo G tambien sirven para aspiradoras Siemens, y las bolsas Rowenta Compacteo son compatibles con algunos modelos de Solac y Moulinex. En nuestro buscador indicamos todos los modelos compatibles para cada bolsa." }
    },
    {
      "@type": "Question",
      "name": "Con que frecuencia debo cambiar la bolsa de mi aspiradora?",
      "acceptedAnswer": { "@type": "Answer", "text": "Se recomienda cambiar la bolsa cada 1-2 meses con uso normal, o cuando notes que la aspiradora pierde potencia de succion. No esperes a que la bolsa este completamente llena, ya que un llenado excesivo reduce la eficiencia de filtrado y puede danar el motor." }
    },
  ]
};

const brands = [
  { name: "Rowenta", slug: "bolsas-aspiradora-rowenta" },
  { name: "Bosch", slug: "bolsas-aspiradora-bosch" },
  { name: "Siemens", slug: null },
  { name: "Karcher", slug: "bolsas-aspiradora-karcher" },
  { name: "Miele", slug: "bolsas-aspiradora-miele" },
  { name: "Taurus", slug: "bolsas-aspiradora-taurus" },
  { name: "Nilfisk", slug: "bolsas-aspiradora-nilfisk" },
  { name: "Ufesa", slug: "bolsas-aspiradora-ufesa" },
  { name: "Solac", slug: "bolsas-aspiradora-solac" },
  { name: "Fagor", slug: "bolsas-aspiradora-fagor" },
  { name: "AEG", slug: "bolsas-aspiradora-aeg-electrolux" },
  { name: "Electrolux", slug: "bolsas-aspiradora-aeg-electrolux" },
  { name: "Philips", slug: null },
  { name: "LG", slug: null },
  { name: "Samsung", slug: null },
  { name: "Moulinex", slug: null },
];
---

<Layout title="Buscador de Bolsas de Aspiradora por Marca y Modelo" description="Encuentra la bolsa compatible con tu aspiradora. Selecciona tu marca y modelo para ver las bolsas recomendadas. Rowenta, Bosch, Karcher, Miele, Taurus, Nilfisk y mas." schema={schema}>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb crumbs={[{ label: "Buscador de Bolsas" }]} />

    <h1 class="text-4xl font-bold mb-4">Buscador de Bolsas de Aspiradora por Marca y Modelo</h1>
    <p class="text-lg text-text-light mb-10">Encuentra la bolsa perfecta para tu aspiradora. Selecciona tu marca o escribe el modelo y te mostramos las bolsas compatibles al mejor precio.</p>

    <!-- Search Section -->
    <section class="bg-bg-card rounded-xl border border-border p-6 mb-10">
      <label for="search-input" class="block text-lg font-semibold mb-3">Busca tu aspiradora</label>
      <input
        type="text"
        id="search-input"
        placeholder="Escribe tu marca o modelo de aspiradora..."
        class="w-full px-5 py-4 text-lg border-2 border-border rounded-xl focus:border-primary focus:outline-none transition-colors bg-white"
        autocomplete="off"
      />

      <p class="text-sm text-text-light mt-4 mb-3">O selecciona una marca:</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-8 gap-2" id="brand-buttons">
        <button data-brand="Rowenta" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Rowenta</button>
        <button data-brand="Bosch" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Bosch</button>
        <button data-brand="Siemens" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Siemens</button>
        <button data-brand="Karcher" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Karcher</button>
        <button data-brand="Miele" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Miele</button>
        <button data-brand="Taurus" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Taurus</button>
        <button data-brand="Nilfisk" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Nilfisk</button>
        <button data-brand="Ufesa" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Ufesa</button>
        <button data-brand="Solac" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Solac</button>
        <button data-brand="Fagor" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Fagor</button>
        <button data-brand="AEG" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">AEG</button>
        <button data-brand="Electrolux" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Electrolux</button>
        <button data-brand="Philips" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Philips</button>
        <button data-brand="LG" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">LG</button>
        <button data-brand="Samsung" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Samsung</button>
        <button data-brand="Moulinex" class="brand-btn px-3 py-2 text-sm font-medium rounded-lg border border-border hover:border-primary hover:text-primary transition-all bg-white">Moulinex</button>
      </div>
    </section>

    <!-- Results Section -->
    <section id="results-section">
      <div id="results-count" class="text-text-light mb-4 hidden"></div>
      <div id="search-results" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      <div id="no-results" class="hidden text-center py-12">
        <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-xl font-semibold text-text-light">No se encontraron resultados</p>
        <p class="text-text-light mt-2">Prueba con otra marca o modelo de aspiradora</p>
      </div>
    </section>

    <!-- Brand pages for SEO internal linking -->
    <section class="mt-16">
      <h2 class="text-2xl font-bold mb-6">Bolsas de aspiradora por marca</h2>
      <p class="text-text-light mb-6">Consulta nuestras guias especializadas por marca con comparativas detalladas, consejos de compatibilidad y las mejores ofertas:</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
        {brands.filter(b => b.slug).map((brand) => (
          <a href={`/${brand.slug}/`} class="flex items-center gap-2 px-4 py-3 bg-bg-card rounded-lg border border-border hover:border-primary hover:shadow-md transition-all group">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span class="font-medium group-hover:text-primary transition-colors">Bolsas {brand.name}</span>
          </a>
        ))}
      </div>
    </section>

    <CtaBanner
      title="No encuentras tu modelo?"
      description="Visita Amazon para explorar todas las bolsas de aspiradora disponibles. Miles de opciones compatibles con todas las marcas y modelos."
      buttonText="Ver todas las bolsas en Amazon"
      buttonUrl="https://www.amazon.es/s?k=bolsas+aspiradora&tag=espacioseco-21"
    />
  </div>

</Layout>

<script>
  const products = [
    { brand: "Rowenta", name: "10 Bolsas Alta Filtracion Rowenta Silence Force", models: ["Silence Force RO64xx", "Compact Power RO39xx", "X-Trem Power RO69xx", "RO6432", "RO6455", "RO3950", "RO6921"], price: "14,90", rating: 4.6, url: "https://www.amazon.es/dp/B07QBC255G?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71aqUU5rZFL._AC_SL300_.jpg" },
    { brand: "Rowenta", name: "10 Bolsas Rowenta Compacteo/Solac", models: ["Compacteo RO17xx", "City Space RO26xx", "Solac AB2723"], price: "12,90", rating: 4.4, url: "https://www.amazon.es/dp/B07R8JNQ42?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "Rowenta", name: "8 Bolsas Rowenta Series RB/RS", models: ["Series RB", "Series RS"], price: "11,90", rating: 4.3, url: "https://www.amazon.es/dp/B09BFCZJ8T?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71G6FqFqczL._AC_SL300_.jpg" },
    { brand: "Bosch", name: "10 Bolsas Hyperfilter Plus Bosch Tipo G", models: ["Bosch GL-20", "GL-30", "GL-40", "Siemens VS06", "VS01", "BSG6", "BSN1"], price: "13,90", rating: 4.5, url: "https://www.amazon.es/dp/B07RHVF8BW?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71n23Xp6tyL._AC_SL300_.jpg" },
    { brand: "Siemens", name: "10 Bolsas Hyperfilter Plus Bosch Tipo G", models: ["Siemens VS06", "VS01", "Bosch GL-20", "GL-30"], price: "13,90", rating: 4.5, url: "https://www.amazon.es/dp/B07RHVF8BW?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71n23Xp6tyL._AC_SL300_.jpg" },
    { brand: "Karcher", name: "10 Bolsas Alta Filtracion Karcher WD3", models: ["WD3", "WD3P", "MV3", "WD3.200", "WD3.300", "WD3.500"], price: "12,90", rating: 4.5, url: "https://www.amazon.es/dp/B0784S9VKF?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71wwUXjsyqL._AC_SL300_.jpg" },
    { brand: "Karcher", name: "5 Bolsas Karcher WD4/WD5/WD6", models: ["WD4", "WD5", "WD6", "MV4", "MV5", "MV6"], price: "9,90", rating: 4.4, url: "https://www.amazon.es/dp/B07SJGCCW6?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71Cgjf-cuTL._AC_SL300_.jpg" },
    { brand: "Karcher", name: "5 Bolsas Karcher A2004/A2024", models: ["A2004", "A2024", "A2054", "WD2"], price: "7,90", rating: 4.3, url: "https://www.amazon.es/dp/B07SCGJ16X?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71Cgjf-cuTL._AC_SL300_.jpg" },
    { brand: "Miele", name: "10 Bolsas + 2 Microfiltros Miele FJM/GN", models: ["Miele Complete C1", "C2", "C3", "Classic C1", "Compact C1", "S200", "S300", "S500", "S4000", "S5000", "S6000", "S8000"], price: "13,90", rating: 4.5, url: "https://www.amazon.es/dp/B07QMZWPFH?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71Cgjf-cuTL._AC_SL300_.jpg" },
    { brand: "Taurus", name: "10 Bolsas Taurus Auris/Micra", models: ["Auris", "Micra", "Avensis", "Golf 1500", "Smart", "Yaris 1500"], price: "11,90", rating: 4.4, url: "https://www.amazon.es/dp/B077XZXL72?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "Taurus", name: "10 Bolsas Taurus Megane/Vitara", models: ["Megane 2200", "Megane 2400", "Vitara 2000", "Vitara 2200", "Polo 2000"], price: "11,90", rating: 4.3, url: "https://www.amazon.es/dp/B07SVJW8SK?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "Nilfisk", name: "10 Bolsas Alta Filtracion Nilfisk Power/Select", models: ["Power P10", "P20", "P40", "Select BLCO14P08A1", "Classic C110", "C120"], price: "14,90", rating: 4.5, url: "https://www.amazon.es/dp/B07HHXS1KS?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71ECpbjb9NL._AC_SL300_.jpg" },
    { brand: "Nilfisk", name: "10 Bolsas Nilfisk Bravo/Action", models: ["Bravo B10", "B20", "Action A100", "A200"], price: "12,90", rating: 4.3, url: "https://www.amazon.es/dp/B07D567S22?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/61+tpQz6LbL._AC_SL300_.jpg" },
    { brand: "Nilfisk", name: "10 Bolsas Nilfisk One/Coupe", models: ["One Prime", "Coupe", "Go", "Coupe Neo"], price: "12,90", rating: 4.3, url: "https://www.amazon.es/dp/B07D56K33G?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/61+tpQz6LbL._AC_SL300_.jpg" },
    { brand: "Ufesa", name: "10 Bolsas Alta Filtracion Ufesa Activa", models: ["Activa AT4210", "AT4220", "Cicerone"], price: "11,90", rating: 4.3, url: "https://www.amazon.es/dp/B07Q3QQBBR?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/613quKCq2pL._AC_SL300_.jpg" },
    { brand: "Solac", name: "10 Bolsas Alta Filtracion Solac", models: ["AB2723", "AB2700", "AB2720", "AB2600"], price: "11,90", rating: 4.3, url: "https://www.amazon.es/dp/B0837TPM53?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71vAmCoaGDL._AC_SL300_.jpg" },
    { brand: "Solac", name: "10 Bolsas Solac/Rowenta Compacteo", models: ["Solac AB2723", "Rowenta Compacteo RO17xx"], price: "12,90", rating: 4.4, url: "https://www.amazon.es/dp/B07R8JNQ42?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "Fagor", name: "10 Bolsas Alta Filtracion Fagor VCE", models: ["VCE-300", "VCE-305", "VCE-306", "VCE-340", "VCE-365"], price: "12,90", rating: 4.3, url: "https://www.amazon.es/dp/B09B29YF5P?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71Cgjf-cuTL._AC_SL300_.jpg" },
    { brand: "Fagor", name: "10 Bolsas Fagor/LG Compatible", models: ["Fagor VCE", "LG V-3310", "V-3300"], price: "12,90", rating: 4.3, url: "https://www.amazon.es/dp/B09KC3QSQY?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "AEG", name: "10 Bolsas Alta Filtracion Electrolux Lux Royal", models: ["AEG Vampyr CE", "Smart 300", "Smart 485"], price: "13,90", rating: 4.4, url: "https://www.amazon.es/dp/B07Z83ZHKL?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71McY5YQPML._AC_SL300_.jpg" },
    { brand: "Electrolux", name: "10 Bolsas Alta Filtracion Electrolux Lux Royal", models: ["Lux Royal D790", "Mondo EL serie"], price: "13,90", rating: 4.4, url: "https://www.amazon.es/dp/B07Z83ZHKL?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71McY5YQPML._AC_SL300_.jpg" },
    { brand: "Philips", name: "10 Bolsas AEG/Electrolux Vampyr", models: ["Philips FC8322", "FC8600", "FC9000 serie", "HR serie"], price: "14,90", rating: 4.5, url: "https://www.amazon.es/dp/B07SGFN26G?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71X5T5GNKCL._AC_SL300_.jpg" },
    { brand: "LG", name: "10 Bolsas Fagor/LG Compatible", models: ["V-3310", "V-3300", "V-CP743"], price: "12,90", rating: 4.3, url: "https://www.amazon.es/dp/B09KC3QSQY?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "Samsung", name: "10 Bolsas Taurus Megane/Vitara", models: ["Samsung SC serie", "VC serie"], price: "11,90", rating: 4.3, url: "https://www.amazon.es/dp/B07SVJW8SK?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
    { brand: "Moulinex", name: "10 Bolsas Rowenta Compacteo/Solac", models: ["Moulinex Compacteo", "City Space"], price: "12,90", rating: 4.4, url: "https://www.amazon.es/dp/B07R8JNQ42?tag=espacioseco-21", image: "https://m.media-amazon.com/images/I/71mcQuQhNKL._AC_SL300_.jpg" },
  ];

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results')!;
  const noResults = document.getElementById('no-results')!;
  const resultsCount = document.getElementById('results-count')!;
  const brandButtons = document.querySelectorAll('.brand-btn');

  let activeBrand: string | null = null;

  function generateStars(rating: number): string {
    return Array.from({ length: 5 }, (_, i) =>
      `<svg class="w-4 h-4 ${i < Math.round(rating) ? 'text-yellow-400' : 'text-gray-300'}" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>`
    ).join('');
  }

  function renderProducts(filtered: typeof products) {
    if (filtered.length === 0) {
      resultsContainer.innerHTML = '';
      noResults.classList.remove('hidden');
      resultsCount.classList.add('hidden');
      return;
    }

    noResults.classList.add('hidden');
    resultsCount.classList.remove('hidden');
    resultsCount.textContent = `${filtered.length} bolsa${filtered.length !== 1 ? 's' : ''} encontrada${filtered.length !== 1 ? 's' : ''}`;

    resultsContainer.innerHTML = filtered.map(product => `
      <article class="bg-bg-card rounded-xl border border-border p-6 hover:shadow-lg hover:border-primary/30 transition-all group">
        <div class="flex flex-col items-center">
          <a href="${product.url}" target="_blank" rel="nofollow noopener sponsored" class="w-40 h-40 mb-4 block">
            <img src="${product.image}" alt="${product.name}" class="w-40 h-40 object-contain transition-transform group-hover:scale-110" loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
            <div class="w-40 h-40 bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg items-center justify-center text-center p-3 border border-blue-200" style="display:none;">
              <span class="text-xs text-blue-600 font-medium leading-tight">${product.name}</span>
            </div>
          </a>
          <span class="inline-block bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full mb-2">${product.brand}</span>
          <a href="${product.url}" target="_blank" rel="nofollow noopener sponsored" class="hover:text-primary transition-colors">
            <h3 class="font-semibold text-center text-lg mb-2">${product.name}</h3>
          </a>
          <div class="flex items-center gap-0.5 mb-2">
            ${generateStars(product.rating)}
            <span class="text-sm text-text-light ml-1">${product.rating}</span>
          </div>
          <p class="text-2xl font-bold text-primary mb-2">${product.price} &euro;</p>
          <div class="mb-4 w-full">
            <p class="text-xs font-semibold text-text-light mb-1">Modelos compatibles:</p>
            <div class="flex flex-wrap gap-1 justify-center">
              ${product.models.map(m => `<span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">${m}</span>`).join('')}
            </div>
          </div>
          <a href="${product.url}" target="_blank" rel="nofollow noopener sponsored"
            class="w-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-bold py-3.5 px-6 rounded-lg text-center transition-all flex items-center justify-center gap-2 shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
            Ver en Amazon
          </a>
          <div class="flex items-center justify-center gap-3 mt-2 text-xs text-text-light">
            <span class="flex items-center gap-1">
              <svg class="w-3 h-3 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
              Compra segura
            </span>
            <span class="flex items-center gap-1">
              <svg class="w-3 h-3 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"/></svg>
              Envio gratis Prime
            </span>
          </div>
        </div>
      </article>
    `).join('');
  }

  function filterProducts() {
    const query = searchInput.value.toLowerCase().trim();

    let filtered = products;

    if (activeBrand) {
      filtered = filtered.filter(p => p.brand === activeBrand);
    }

    if (query) {
      filtered = filtered.filter(p =>
        p.brand.toLowerCase().includes(query) ||
        p.name.toLowerCase().includes(query) ||
        p.models.some(m => m.toLowerCase().includes(query))
      );
    }

    renderProducts(filtered);
  }

  // Brand button click handling
  brandButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const brand = (btn as HTMLElement).dataset.brand!;

      if (activeBrand === brand) {
        // Deselect
        activeBrand = null;
        btn.classList.remove('bg-primary', 'text-white', 'border-primary');
        btn.classList.add('bg-white');
      } else {
        // Deselect all first
        brandButtons.forEach(b => {
          b.classList.remove('bg-primary', 'text-white', 'border-primary');
          b.classList.add('bg-white');
        });
        // Select this one
        activeBrand = brand;
        btn.classList.add('bg-primary', 'text-white', 'border-primary');
        btn.classList.remove('bg-white');
      }

      searchInput.value = '';
      filterProducts();
    });
  });

  // Text input handling
  searchInput.addEventListener('input', () => {
    // When typing, deselect brand buttons
    if (searchInput.value.trim()) {
      activeBrand = null;
      brandButtons.forEach(b => {
        b.classList.remove('bg-primary', 'text-white', 'border-primary');
        b.classList.add('bg-white');
      });
    }
    filterProducts();
  });

  // Show all products on initial load
  renderProducts(products);
</script>
